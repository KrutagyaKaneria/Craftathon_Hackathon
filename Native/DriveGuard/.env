# Backend API URL - Your local network IP
# UPDATE THIS IF YOUR BACKEND IP CHANGES
# 
# To find your IP:
#   Windows: Run 'ipconfig' in terminal, look for 'IPv4 Address'
#   Mac/Linux: Run 'ifconfig' or 'hostname -I'
# 
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:5000
# Verified IP: 10.44.202.155 (from ipconfig)
EXPO_PUBLIC_API_URL=http://10.44.202.155:5000

# Debug mode - set to 'true' to enable extra logging
# EXPO_PUBLIC_DEBUG=true