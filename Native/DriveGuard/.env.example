# DriveGuard Native App - Environment Configuration

# Backend API URL
# For LOCAL development (same machine):
# EXPO_PUBLIC_API_URL=http://localhost:5000

# For LOCAL development (different machines - use your computer's IP):
# Windows: ipconfig | Mac/Linux: ifconfig
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5000

# For PRODUCTION:
# EXPO_PUBLIC_API_URL=https://your-backend-domain.com

EXPO_PUBLIC_API_URL=http://localhost:5000

# App Information
EXPO_PUBLIC_APP_NAME=DriveGuard
EXPO_PUBLIC_APP_VERSION=1.0.0

# Optional: Feature flags
# EXPO_PUBLIC_DEBUG_MODE=false
# EXPO_PUBLIC_ENABLE_LOGGING=true
