# Database
MONGODB_URI=mongodb://localhost:27017/driver_safety

# Backend Integrations
BACKEND_URL=http://localhost:8000/api/v1/events

# Module Thresholds (Optional Defaults Provided in App)
FATIGUE_EAR_THRESHOLD=0.25
FATIGUE_MAR_THRESHOLD=0.7
RASH_ACCEL_THRESHOLD=3.4
RASH_BRAKE_THRESHOLD=-4.4
RASH_GYRO_THRESHOLD=2.2
RASH_NOISE_DEADZONE=0.25
RASH_MIN_CONSECUTIVE_HITS=3
RASH_BRAKE_MIN_CONSECUTIVE_HITS=1
RASH_ACCEL_HIGH_MULTIPLIER=1.6
RASH_BRAKE_HIGH_MULTIPLIER=1.6
RASH_GYRO_HIGH_MULTIPLIER=1.6

# Owner Alert Anti-Spam / Aggregation
FATIGUE_ALERT_MIN_CONSECUTIVE=2
RASH_ALERT_MIN_CONSECUTIVE=3
FATIGUE_ALERT_COOLDOWN_SECONDS=120
RASH_ALERT_COOLDOWN_SECONDS=45
ALERT_STALE_RESET_SECONDS=30
